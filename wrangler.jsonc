{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gaming-website",
  "compatibility_date": "2026-05-29",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "GITHUB_OWNER": "RasberryPhi-AT",
    "GITHUB_REPO": "gaming-website"
  }
}
